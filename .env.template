# NSE Scraper - Environment Variables Template
# Copy this file to .env and update values

# ============================================
# MongoDB Atlas Configuration
# ============================================
# Get your connection string from MongoDB Atlas Dashboard
# Format: mongodb+srv://username:password@cluster.mongodb.net/
MONGO_URI=mongodb+srv://nse_scraper_user:YOUR_PASSWORD@nse-scraper-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=NSE_SCRAPER
MONGO_DB_MASTER=GETMASTERDATA

# ============================================
# Scraping Configuration
# ============================================
# Data collection interval in minutes (5-10 recommended for production)
DATA_COLLECTION_INTERVAL=5

# Cookie refresh interval in minutes
COOKIE_REFRESH_INTERVAL=60

# ============================================
# Server Configuration
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=1020
DEBUG=false

# ============================================
# Timezone
# ============================================
TZ=Asia/Kolkata
